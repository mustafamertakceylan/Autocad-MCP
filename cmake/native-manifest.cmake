if(NOT EXISTS "${BINARY}")
  message(FATAL_ERROR "Native binary missing")
endif()
file(SHA256 "${BINARY}" BINARY_SHA256)
if(TESTING)
  set(JSON_TESTING true)
else()
  set(JSON_TESTING false)
endif()
file(WRITE "${BINARY}.json" "{\n  \"format\":1,\n  \"product\":\"autocad-mcp\",\n  \"version\":\"${VERSION}\",\n  \"autocad\":\"2027\",\n  \"platform\":\"win32\",\n  \"arch\":\"x64\",\n  \"testing\":${JSON_TESTING},\n  \"buildId\":\"${BUILD_ID}\",\n  \"sha256\":\"${BINARY_SHA256}\"\n}\n")
